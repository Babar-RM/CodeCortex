PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Auth.js / GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
AUTH_SECRET=generate_with_npx_auth_secret_or_min_32_chars_random_string

# Postgres Database URL (Neon / Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codecortex?schema=public
